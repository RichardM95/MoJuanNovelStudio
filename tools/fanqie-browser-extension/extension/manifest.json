{
  "manifest_version": 3,
  "name": "墨卷逐章填表",
  "version": "0.3.0",
  "description": "手动填稿，或接收墨卷授权作品的逐章草稿任务并核验存稿。",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
